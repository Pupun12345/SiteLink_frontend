<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Advertising ID: jaan-boojh kar HATAYI GAYI ──────────────────
         App me koi ads nahi hain aur advertising ID kahin use nahi hoti.
         Ye permission humne likhi nahi thi — Firebase Analytics
         (play-services-measurement-api) ki library manifest se apne aap
         merge ho jaati thi. Uski wajah se Play Console kehta tha ki
         "aapka app advertising ID use karta hai", aur Data safety me
         "No" chunne par release block ho jaati thi.

         `tools:node="remove"` merger ko bolta hai ki kisi bhi library se
         aayi ye permission final manifest me mat daalo. Neeche
         ACCESS_ADSERVICES_* bhi usi library se aati thi. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove"/>

    <!-- "Get Directions" — current location ko origin banane ke liye -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- API calls + Razorpay checkout ke liye zaroori (release build me implicit nahi hota) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ (API 33+) runtime permission — push notifications dikhane ke liye -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Experience description ka mic (speech-to-text) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="sitelink"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:enableOnBackInvokedCallback="true">
        <!-- Maps SDK for Android — Play Store build only, iOS key wire nahi kiya -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCUiNpBnM_kPZZtNRoOS-vZisNg1KV4Mio"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ── Deep links ──────────────────────────────────────────
                 1) Custom scheme: sitelink://post/<id>
                 Ye hamesha kaam karta hai — na domain chahiye na https.
                 Backend ka share page isi ko intent:// se trigger karta hai. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="sitelink" android:host="post"/>
                <data android:scheme="sitelink" android:host="job"/>
            </intent-filter>

            <!-- 2) Web link: https://app-sitelink.smartnex.tech/p/<id>
                 autoVerify ab "true" hai — backend asli https domain par
                 aa gaya hai. Verify tabhi pass hoga jab wo domain
                 /.well-known/assetlinks.json serve kare jisme release
                 keystore ka SHA-256 ho (backend me
                 ANDROID_SHA256_FINGERPRINTS). Tab tak link chooser ke
                 saath khulega — toota kuch nahi, bas seedha app me nahi
                 jayega.
                 Sirf https rakha hai: http par assetlinks verify nahi
                 hota, aur plain-http link ab chahiye bhi nahi. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- /p = community post, /j = job -->
                <data android:scheme="https" android:host="app-sitelink.smartnex.tech"
                      android:pathPrefix="/p"/>
                <data android:scheme="https" android:host="app-sitelink.smartnex.tech"
                      android:pathPrefix="/j"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FCM background/terminated notifications default into this channel
             (must match the channel created in notification_service.dart) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sitelink_default_channel" />
        <!-- App band ho tab FCM khud notification dikhata hai — uska status bar
             icon (safed SiteLink "S") aur rang. Ye na ho to Android launcher
             icon ka safed dabba ya Flutter ka icon dikhata hai. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Razorpay checkout — Android 11+ (API 30+) package-visibility ke
             bina UPI apps checkout sheet me nahi dikhte -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.APP_MARKET"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="upi"/>
        </intent>
        <!-- Speech-to-text — Android 11+ (API 30+) package visibility ke bina
             speech_to_text ko device ka recognizer milta hi nahi -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
